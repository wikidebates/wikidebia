{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph_correction.schema.json",
  "title": "Wikidéb'IA — Correction structurelle d'un graphe après rejet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "debate_id", "source_build_sha256",
    "rejected_review_sha256", "status", "reviewer", "reviewed_at", "notes", "placements"
  ],
  "properties": {
    "schema": {"const": "wikidebia-graph-correction-1.0"},
    "schema_version": {"const": "1.0"},
    "debate_id": {"type": "string", "minLength": 1},
    "source_build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rejected_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pending", "corrected", "applied"]},
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "applied_at": {"type": "string"},
    "resulting_build_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence_id", "node_id", "parent_occurrence_id", "relation",
          "branch", "order", "occurrence_role"
        ],
        "properties": {
          "occurrence_id": {"$ref": "common.schema.json#/$defs/occurrenceId"},
          "node_id": {"$ref": "common.schema.json#/$defs/nodeId"},
          "parent_occurrence_id": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "common.schema.json#/$defs/occurrenceId"}
            ]
          },
          "relation": {
            "oneOf": [
              {"type": "null"},
              {"enum": ["justification", "objection"]}
            ]
          },
          "branch": {
            "oneOf": [
              {"type": "null"},
              {"enum": ["pro", "con"]}
            ]
          },
          "order": {"type": "integer", "minimum": 1},
          "occurrence_role": {"enum": ["primary", "secondary"]}
        }
      }
    }
  }
}
