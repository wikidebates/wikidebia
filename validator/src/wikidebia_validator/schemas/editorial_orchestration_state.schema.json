{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial_orchestration_state.schema.json",
  "title": "Wikidéb'IA — État d'orchestration éditoriale",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "normative_revision",
    "validator_version",
    "kit_version",
    "debate_id",
    "debate_title",
    "phase",
    "status",
    "work_id",
    "pending_review",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "wikidebia-editorial-orchestration-1.0"
    },
    "schema_version": {
      "const": "1.0"
    },
    "normative_revision": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "validator_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kit_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "debate_title": {
      "type": "string",
      "minLength": 1
    },
    "short_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "awaiting_review",
        "release_ready",
        "blocked",
        "blocked_technical"
      ]
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_review": {
      "type": [
        "object",
        "null"
      ]
    },
    "snapshot_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "force_refresh": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "updated_at": {
      "type": "string",
      "minLength": 10
    },
    "release": {
      "type": "object"
    },
    "last_block": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
