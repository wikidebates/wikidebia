{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_review_response.schema.json",
  "title": "Wikidéb'IA — Réponse éditoriale de convergence sémantique",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "pass_number",
    "method_family",
    "method",
    "reviewer",
    "note",
    "new_certain_errors",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "wikidebia-semantic-review-response-1.0"
    },
    "schema_version": {
      "const": "1.0"
    },
    "pass_number": {
      "enum": [
        1,
        2
      ]
    },
    "method_family": {
      "enum": [
        "proposition_by_proposition",
        "risk_marker_review",
        "reverse_source_target",
        "field_boundary_review",
        "independent_bilingual_reread"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "new_certain_errors": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
