{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wikidebia-validator-report.schema.json",
  "title": "Rapport structuré du validateur Wikidéb'IA",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validator_version",
    "package_root",
    "scopes",
    "result",
    "result_scope",
    "result_meaning",
    "validation_layers",
    "summary",
    "metrics",
    "findings"
  ],
  "properties": {
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "package_root": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "result": {
      "enum": [
        "passed",
        "passed_with_warnings",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "infos"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "infos": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "level",
          "message",
          "path",
          "pointer",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^WDV-[A-Z]{2,3}-[0-9]{3}$"
          },
          "level": {
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "pointer": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "result_scope": {
      "const": "automated_validation"
    },
    "result_meaning": {
      "type": "string",
      "minLength": 1
    },
    "validation_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural",
        "documentary",
        "semantic_review",
        "fresh_archive"
      ],
      "properties": {
        "structural": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "errors",
            "warnings",
            "infos",
            "meaning"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "passed_with_warnings",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "infos": {
              "type": "integer",
              "minimum": 0
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "documentary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "errors",
            "warnings",
            "infos",
            "meaning"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "passed_with_warnings",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "infos": {
              "type": "integer",
              "minimum": 0
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "semantic_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "errors",
            "warnings",
            "infos",
            "meaning"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "passed_with_warnings",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "infos": {
              "type": "integer",
              "minimum": 0
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fresh_archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "errors",
            "warnings",
            "infos",
            "meaning"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "passed_with_warnings",
                "failed",
                "not_run",
                "not_applicable"
              ]
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "infos": {
              "type": "integer",
              "minimum": 0
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
