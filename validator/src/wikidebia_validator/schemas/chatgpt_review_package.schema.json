{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt_review_package.schema.json",
  "title": "Wikidéb'IA — Manifeste de paquet de revue ChatGPT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package_id",
    "review_type",
    "debate_id",
    "work_id",
    "normative_revision",
    "validator_version",
    "kit_version",
    "prepared_at",
    "source_anchor_sha256",
    "editable_files",
    "context_files",
    "counts",
    "instructions_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "wikidebia-chatgpt-review-package-1.0"
    },
    "schema_version": {
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "review_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9_]+$"
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "normative_revision": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "validator_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kit_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "prepared_at": {
      "type": "string",
      "minLength": 10
    },
    "source_anchor_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "editable_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_path",
          "target_path",
          "sha256_at_prepare"
        ],
        "properties": {
          "package_path": {
            "type": "string",
            "pattern": "^editable/"
          },
          "target_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.+@()' éèêàùçÉÈÊÀÙÇ\\-]+(?:/[A-Za-z0-9_.+@()' éèêàùçÉÈÊÀÙÇ\\-]+)*$"
          },
          "sha256_at_prepare": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "context_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_path",
          "target_path",
          "sha256"
        ],
        "properties": {
          "package_path": {
            "type": "string",
            "pattern": "^context/"
          },
          "target_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.+@()' éèêàùçÉÈÊÀÙÇ\\-]+(?:/[A-Za-z0-9_.+@()' éèêàùçÉÈÊÀÙÇ\\-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": true
    },
    "instructions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
