{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argument_name_discovery_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "debate_id",
    "entries"
  ],
  "properties": {
    "version": {
      "enum": [
        "wikidebia-argument-name-discovery-review-1.0",
        "wikidebia-argument-name-discovery-review-1.1",
        "wikidebia-argument-name-discovery-review-1.2"
      ]
    },
    "normative_revision": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Métadonnée historique de traçabilité; le format de cette revue est déterminé par version."
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "page_id",
          "title",
          "page_origin",
          "search_reviewed",
          "search_queries",
          "search_scope_note",
          "outcome",
          "name",
          "evidence",
          "same_reasoning_confirmed",
          "non_invented_label_confirmed",
          "language_fit_confirmed",
          "rationale"
        ],
        "properties": {
          "language": {
            "enum": [
              "fr",
              "en"
            ]
          },
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page_origin": {
            "const": "new"
          },
          "search_reviewed": {
            "const": true
          },
          "search_queries": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "search_scope_note": {
            "type": "string",
            "minLength": 12
          },
          "outcome": {
            "enum": [
              "none",
              "known_name"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "label_as_used",
                "locator"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 6
                },
                "label_as_used": {
                  "type": "string",
                  "minLength": 2
                },
                "locator": {
                  "type": "string",
                  "minLength": 2
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(https?://.*)?$"
                }
              }
            }
          },
          "same_reasoning_confirmed": {
            "type": "boolean"
          },
          "non_invented_label_confirmed": {
            "type": "boolean"
          },
          "language_fit_confirmed": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 12
          },
          "search_provenance": {
            "enum": [
              "actual_log",
              "fresh_recheck",
              "historical_reconstruction"
            ]
          },
          "search_provenance_note": {
            "type": "string",
            "minLength": 12
          },
          "page_reasoning_scope_summary": {
            "type": "string",
            "minLength": 12
          },
          "literature_name_scope_summary": {
            "type": "string"
          },
          "scope_relation": {
            "type": "string",
            "enum": [
              "",
              "exact_match",
              "broader_than_page",
              "narrower_than_page",
              "ambiguous"
            ]
          },
          "scope_identity_confirmed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "known_name"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2
                },
                "evidence": {
                  "minItems": 1
                },
                "same_reasoning_confirmed": {
                  "const": true
                },
                "non_invented_label_confirmed": {
                  "const": true
                },
                "language_fit_confirmed": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "name": {
                  "type": "null"
                },
                "same_reasoning_confirmed": {
                  "const": false
                },
                "non_invented_label_confirmed": {
                  "const": true
                },
                "language_fit_confirmed": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "wikidebia-argument-name-discovery-review-1.1"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "allOf": [
                {
                  "required": [
                    "search_provenance",
                    "search_provenance_note"
                  ]
                },
                {
                  "if": {
                    "properties": {
                      "language": {
                        "const": "en"
                      },
                      "page_origin": {
                        "const": "new"
                      }
                    },
                    "required": [
                      "language",
                      "page_origin"
                    ]
                  },
                  "then": {
                    "properties": {
                      "search_provenance": {
                        "enum": [
                          "actual_log",
                          "fresh_recheck"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "wikidebia-argument-name-discovery-review-1.2"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "allOf": [
                {
                  "required": [
                    "search_provenance",
                    "search_provenance_note",
                    "page_reasoning_scope_summary"
                  ]
                },
                {
                  "if": {
                    "properties": {
                      "outcome": {
                        "const": "known_name"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  },
                  "then": {
                    "required": [
                      "literature_name_scope_summary",
                      "scope_relation",
                      "scope_identity_confirmed"
                    ],
                    "properties": {
                      "scope_relation": {
                        "const": "exact_match"
                      },
                      "scope_identity_confirmed": {
                        "const": true
                      },
                      "literature_name_scope_summary": {
                        "type": "string",
                        "minLength": 12
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
