{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary_style_review.schema.json",
  "title": "Wikidéb'IA — Revue individuelle des résumés",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "normative_revision",
    "debate_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "normative_revision": {
      "type": "string",
      "minLength": 1
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "languages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "languages": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
              "^(fr|en)$": {
                "type": "object",
                "properties": {
                  "originality_reviewed": {
                    "const": true
                  },
                  "mechanism_statement": {
                    "type": "string",
                    "minLength": 30
                  }
                },
                "additionalProperties": true,
                "oneOf": [
                  {
                    "properties": {
                      "status": {
                        "const": "historical_absent"
                      },
                      "historical_absence_verified": {
                        "const": true
                      },
                      "note": {
                        "type": "string",
                        "minLength": 12
                      }
                    },
                    "required": [
                      "status",
                      "historical_absence_verified",
                      "note"
                    ]
                  },
                  {
                    "properties": {
                      "status": {
                        "const": "historical_existing"
                      },
                      "historical_content_preserved": {
                        "const": true
                      },
                      "note": {
                        "type": "string",
                        "minLength": 12
                      }
                    },
                    "required": [
                      "status",
                      "historical_content_preserved",
                      "note"
                    ]
                  },
                  {
                    "properties": {
                      "status": {
                        "enum": [
                          "approved",
                          "revised",
                          "translated_and_reviewed"
                        ]
                      },
                      "originality_reviewed": {
                        "const": true
                      },
                      "mechanism_statement": {
                        "type": "string",
                        "minLength": 30
                      }
                    },
                    "required": [
                      "status",
                      "originality_reviewed",
                      "mechanism_statement"
                    ]
                  }
                ]
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "quality_policy_revision": {
      "const": "1.2.38"
    },
    "summary_policy_revision": {
      "enum": [
        "1.2.39",
        "1.2.40"
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "quality_policy_revision"
      ]
    },
    {
      "required": [
        "summary_policy_revision"
      ]
    }
  ]
}
