{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "documentary_resource_registry.schema.json",
  "title": "Wikidéb'IA — Registre global normalisé des ressources documentaires",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_registry_version", "debate_id", "source_registry_sha256", "resources"],
  "properties": {
    "resource_registry_version": {"const": "1.0"},
    "debate_id": {"$ref": "common.schema.json#/$defs/debateId"},
    "source_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identity_type", "identity_key", "canonical_url", "doi", "source_ids", "languages", "labels", "metadata_variants", "conflicts"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9A-F]{12}$"},
          "identity_type": {"enum": ["doi", "url", "bibliographic_fingerprint"]},
          "identity_key": {"type": "string", "minLength": 5},
          "canonical_url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https?://"}]},
          "doi": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^10\\.\\d{4,9}/.+$"}]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceId"}},
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/language"}},
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "label"],
              "properties": {"language": {"$ref": "common.schema.json#/$defs/language"}, "label": {"type": "string", "minLength": 1}}
            }
          },
          "metadata_variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "language", "type", "label", "authors", "date", "publisher_or_site"],
              "properties": {
                "source_id": {"$ref": "common.schema.json#/$defs/sourceId"},
                "language": {"$ref": "common.schema.json#/$defs/language"},
                "type": {"enum": ["bibliography", "webliography", "videography"]},
                "label": {"type": "string"},
                "authors": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "date": {"type": "string"},
                "publisher_or_site": {"type": "string"}
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "language", "source_ids", "labels"],
              "properties": {
                "kind": {"const": "same_identity_incompatible_label"},
                "language": {"$ref": "common.schema.json#/$defs/language"},
                "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/sourceId"}},
                "labels": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
