{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Wikidéb'IA — Transmission entre Work",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "handoff_schema_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "template_mode": {
      "type": "boolean"
    },
    "handoff_id": {
      "$ref": "common.schema.json#/$defs/handoffId"
    },
    "debate_id": {
      "$ref": "common.schema.json#/$defs/debateId"
    },
    "origin": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "work_type": {
          "$ref": "common.schema.json#/$defs/workType"
        },
        "completed_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "result": {
          "type": "string",
          "enum": [
            "success",
            "blocked",
            "failed",
            "template"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_type",
        "completed_at",
        "result"
      ]
    },
    "destination": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "work_type": {
          "$ref": "common.schema.json#/$defs/workType"
        },
        "required_global_status": {
          "$ref": "common.schema.json#/$defs/globalStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "work_id",
        "work_type",
        "required_global_status"
      ]
    },
    "normative_versions": {
      "$ref": "common.schema.json#/$defs/normativeVersions"
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/nullableSha256"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "required"
        ]
      },
      "minItems": 1
    },
    "required_validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "validation_type": {
            "$ref": "common.schema.json#/$defs/validationScope"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "passed_with_warnings"
            ]
          },
          "report_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        },
        "additionalProperties": false,
        "required": [
          "validation_type",
          "status",
          "report_path"
        ]
      }
    },
    "locked_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorized_output_paths": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "authorized_registry_updates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "handoff_schema_version",
    "template_mode",
    "handoff_id",
    "debate_id",
    "origin",
    "destination",
    "normative_versions",
    "required_files",
    "required_validations",
    "locked_fields",
    "authorized_output_paths",
    "authorized_registry_updates",
    "forbidden_actions",
    "notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "template_mode": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "origin": {
            "properties": {
              "result": {
                "enum": [
                  "success",
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "required_files": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "required": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "sha256": {
                        "$ref": "common.schema.json#/$defs/sha256"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "origin": {
            "properties": {
              "result": {
                "const": "template"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Transmission entre Work, version 1.0, révision corrective 1.0.6."
}
